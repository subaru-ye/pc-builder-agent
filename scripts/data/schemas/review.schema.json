{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-builder-agent.local/schemas/review.schema.json",
  "title": "P11 review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "base_release_id", "input_sha256", "parts_sha256", "evidence_sha256", "changes", "evidence_changes", "risks", "decision"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "base_release_id": {"type": ["string", "null"], "format": "uuid"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changes": {"type": "array", "items": {"type": "object"}},
    "evidence_changes": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "decision": {"enum": ["no_change", "auto_publish", "quarantine", "manual_required"]}
  }
}
