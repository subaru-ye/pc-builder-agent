{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../docs/api/openapi.yaml -o src/lib/api/generated.ts",
    "api:schemas": "openapi-zod-client ../docs/api/openapi.yaml -o src/lib/api/generated-schemas.ts -t node_modules/openapi-zod-client/src/templates/schemas-only.hbs --export-schemas && node scripts/finalize-api-schemas.mjs",
    "api:generate": "pnpm api:types && pnpm api:schemas",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/lib/api/generated.ts src/lib/api/generated-schemas.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:requirements": "playwright test --config=playwright.requirements.config.ts",
    "test:orchestrator": "node --test e2e-live/*.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@pdfmergy-embedpdf/fonts-sc": "2.6.5",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "openapi-zod-client": "1.18.3",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
