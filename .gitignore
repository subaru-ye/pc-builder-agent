# 读书笔记,不随项目开源
docs/ai-agent-book/

# 环境与密钥
.env

# Go 构建产物(go.sum 必须入库,勿加)
bin/
*.exe
*.test
*.out

# 本地工具链(golangci-lint 等,go install 定向 GOBIN 产物)
.tools/

# Python(P1 起 scripts/ 使用)
.venv/
__pycache__/
*.pyc

# 上游原始大文件快照(锁定 commit 可随时重拉,不入库)
scripts/data/upstream/

# P11 本机自动数据管道:原始响应、隔离项、不可变 release 与调度状态
scripts/data/work/
# 本地运行产物兜底(评估输出、临时快照等未归类内容)
var/
var/data/
# 本地服务启动脚本、进程日志与运行产物
var/run/
# 本地备份(数据库 dump 与 release 快照)
var/backups/

# 覆盖率脚本生成产物
scripts/data/_cov.json

# P10 本地验收原始指标、trace 与截图(仓库只提交脱敏汇总)
artifacts/

# 本机 AI 助手记忆与任务计划
.workbuddy/
.zcode/

# OS
.DS_Store
Thumbs.db
