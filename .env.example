# 复制为 .env 后填写(.env 已在 .gitignore,勿提交真实 key)
# 三个角色可独立选择供应商。未配置 provider 时兼容旧行为，默认使用百炼。
SCREENING_PROVIDER=bailian
BUILDER_PROVIDER=bailian
EMBEDDING_PROVIDER=bailian

# 阿里百炼 API key(控制台创建):chat 与 embedding 可共用一个 key
DASHSCOPE_API_KEY=sk-你的百炼key
# 可选:工作空间专属 Host(控制台创建 key 时显示的「OpenAI 兼容地址」);不填则用公共端点
# DASHSCOPE_BASE_URL=https://你的专属host.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# P12B SerpApi Free / Baidu Shopping（真实 canary 前填写；不得提交真实值）
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_MONTHLY_REQUEST_BUDGET=240
SERPAPI_DAILY_SKUS=7
SERPAPI_REQUIRE_FREE_PLAN=true
# 模型 Code 按百炼免费额度独立计算；优先使用控制台显示仍有额度的精确 Code。
SCREENING_MODEL=qwen3.7-plus
BUILDER_MODEL=qwen3.7-plus-2026-05-26
EMBEDDING_MODEL=qwen3.7-text-embedding
SCREENING_REASONING_EFFORT=none
# 该固定版本在 Responses 实测传 low 会返回 400；none 的 function calling 正常。
BUILDER_REASONING_EFFORT=none

# 小米 MiMo Responses 端点。选择 mimo 的角色必须显式设置对应 MODEL；MiMo
# 当前不支持本项目 embedding，builder 只允许 reasoning.effort=none。
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 可选:SCREENING_/BUILDER_/EMBEDDING_ 的 API_KEY 与 BASE_URL 会覆盖供应商级配置。
# openai_compatible 仅支持实现 /responses 的端点，并要求显式 MODEL/API_KEY/BASE_URL。
# SCREENING_API_KEY=
# SCREENING_BASE_URL=
# BUILDER_API_KEY=
# BUILDER_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# 百炼私有 Session cache header 默认启用，不会发送给 MiMo 或通用端点。
BAILIAN_SESSION_CACHE=true
# SDK 自动重试默认关闭，避免响应丢失后重复计费；产品显式重试仍使用新的幂等键。
MODEL_MAX_RETRIES=0

# 以下两项为 P1 起生效的连接约定,端口与 docker-compose.yml 一致
# 密码仅本地开发用
PG_DSN=postgres://pcbuilder:pcbuilder@localhost:15432/pcbuilder?sslmode=disable
# P6 起 REDIS_ADDR 被消费:会话热上下文两进程共享 + embedding 缓存;不设则降级(会话回退
# 进程内 InMemory、缓存停用)。阶段 1 本地完整验收建议把会话 TTL 设为 720h;
# 代码未配置时仍使用 24h fallback。TTL 用 Go duration 写法(如 24h / 168h / 720h)。
REDIS_ADDR=localhost:16379
REDIS_SESSION_TTL=720h
REDIS_CACHE_TTL=168h

# P5 A2A 单跳拆分:cmd/buildsvc 远程服务的监听地址与 cmd/host 消费的 URL
# buildsvc 监听地址(默认 :8081);host 从下面 URL 的 well-known 路径解析 agent card
BUILDSVC_ADDR=:8081
BUILDSVC_URL=http://localhost:8081

# P7 产品 API、P8 Web 工作台与 P9 分享。
API_ADDR=:8082
PUBLIC_WEB_BASE_URL=http://localhost:3000
# P9 必填:独立的 base64url 密钥,解码后至少 32 字节;不得复用百炼 API key。
SHARE_TOKEN_SECRET=
# 留空时自动使用 PUBLIC_WEB_BASE_URL 的 origin;需要分离前后端域名时填写一个精确 origin。
WEB_ALLOWED_ORIGIN=
RUN_EVENT_TTL=24h
