# 复制为 .env 后填写(.env 已在 .gitignore,勿提交真实 key)
# 阿里百炼 API key(控制台创建):chat 与 embedding 共用一个 key
DASHSCOPE_API_KEY=sk-你的百炼key
# 可选:工作空间专属 Host(控制台创建 key 时显示的「OpenAI 兼容地址」);不填则用公共端点
# DASHSCOPE_BASE_URL=https://你的专属host.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 以下两项为 P1 起生效的连接约定(P0 代码不消费),端口与 docker-compose.yml 一致
# 密码仅本地开发用
PG_DSN=postgres://pcbuilder:pcbuilder@localhost:15432/pcbuilder?sslmode=disable
REDIS_ADDR=localhost:16379
